<?xml version="1.0" encoding="utf-8"?>
<!-- Publishes a self-contained win-x64 build to publish\web. Upload that folder's contents to the
     halalbook.app site root on SmarterASP.net (FTP or the File Manager). -->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <PublishUrl>$(MSBuildThisFileDirectory)..\..\..\..\publish\web\</PublishUrl>
    <PublishDir>$(PublishUrl)</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <EnvironmentName>Production</EnvironmentName>
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
  </PropertyGroup>
</Project>
