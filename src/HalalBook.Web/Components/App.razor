@inject IConfiguration Config
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b3d2e" />
    <meta name="description" content="HalalBook is a beautiful, intelligent social network for Muslims: friends, family groups, reels, live shows, prayer times, Qibla and posts in 19 languages, in a safe, halal space." />
    <meta name="keywords" content="HalalBook, Muslim social network, halal social media, Islamic social network, Ummah, Muslim community, prayer times, Qibla, Islamic reels, Muslim friends" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="application-name" content="HalalBook" />
    @foreach (var (name, key) in Verifications)
    {
        if (Config[$"Seo:{key}"] is { Length: > 0 } value) { <meta name="@name" content="@value" /> }
    }
    @if (!IsSharedPost)
    {
        @* Shared posts (/p/{id}) and invites (/join/{code}) write their own preview tags. *@
        <meta property="og:site_name" content="HalalBook" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="@SiteUrl/" />
        <meta property="og:title" content="HalalBook: the social home for the Ummah" />
        <meta property="og:description" content="Friends, family groups, reels, live shows, prayer times and 19 languages, in a safe, halal space." />
        <meta property="og:image" content="@SiteUrl/img/og-image.png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content="@SiteUrl/img/og-image.png" />
    }
    <script type="application/ld+json">@((MarkupString)StructuredData)</script>
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Noto+Sans+Arabic:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Reem+Kufi:wght@500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["HalalBook.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="img/icon-192.png" />
    <link rel="apple-touch-icon" href="img/icon-192.png" />
    <link rel="manifest" href="manifest.webmanifest" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script>window.halalbookApi = "@ApiBase";</script>
    <script src="js/app.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js" crossorigin="anonymous"></script>
    <script src="js/live.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    private static readonly (string Name, string Key)[] Verifications =
    [
        ("google-site-verification", "GoogleVerification"), ("msvalidate.01", "BingVerification"),
        ("yandex-verification", "YandexVerification"), ("baidu-site-verification", "BaiduVerification"),
        ("naver-site-verification", "NaverVerification"),
    ];

    private string SiteUrl => SearchEngineFiles.SiteUrl(Config);
    private bool IsSharedPost => HttpContext.Request.Path.StartsWithSegments("/p") || HttpContext.Request.Path.StartsWithSegments("/join");

    // Tells search engines what HalalBook is, so it can show as a named site with a search box.
    private string StructuredData => System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@graph"] = new object[]
        {
            new Dictionary<string, object>
            {
                ["@type"] = "Organization", ["name"] = "HalalBook", ["url"] = SiteUrl + "/",
                ["logo"] = SiteUrl + "/img/icon-512.png",
            },
            new Dictionary<string, object>
            {
                ["@type"] = "WebSite", ["name"] = "HalalBook", ["url"] = SiteUrl + "/",
                ["inLanguage"] = Languages.All.Select(l => l.Code).ToArray(),
                ["potentialAction"] = new Dictionary<string, object>
                {
                    ["@type"] = "SearchAction", ["target"] = SiteUrl + "/search?q={search_term_string}",
                    ["query-input"] = "required name=search_term_string",
                },
            },
        },
    });

    private string ApiBase => (Config["Api:BaseUrl"] ?? "https://api.halalbook.app/").TrimEnd('/') + "/";

    // Public share pages (/p/{id}) render on the server so WhatsApp, Facebook and others can read their link previews;
    // everything else is the interactive app.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? new InteractiveServerRenderMode(prerender: false) : null;
}
