@page "/messages"
@page "/messages/{Id:guid}"
@implements IDisposable
@inject ApiClient Api
@inject AuthSession Session
@inject Realtime Realtime
@inject ClientClock Clock
@inject Toasts Toasts
@inject IJSRuntime JS

<PageTitle>Messages · HalalBook</PageTitle>

<div class="chat @(Id is null ? "" : "open")">
    <div class="chat-list">
        <div style="padding:1rem 1rem .5rem"><h2 style="margin:0">Messages</h2></div>
        @foreach (var c in conversations)
        {
            <a class="chat-item @(c.Id == Id ? "active" : "")" href="/messages/@c.Id">
                @if (c.Participants.FirstOrDefault() is { } other) { <Avatar User="other" Size="48" Link="false" /> } else { <span class="avatar" style="--size:48px">📝</span> }
                <div class="grow">
                    <div style="font-weight:@(c.UnreadCount > 0 ? 800 : 600)">@c.Title</div>
                    <div class="subtle" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@(c.LastMessage is { } m ? (m.Sender.Id == Session.User?.Id ? "You: " : "") + m.Content : "Say salaam 👋")</div>
                </div>
                @if (c.UnreadCount > 0) { <span class="unread"></span> }
            </a>
        }
        @if (conversations.Count == 0) { <Empty Title="No conversations yet" Text="Visit a profile and tap Message to start one." /> }
    </div>

    <div class="chat-main">
        @if (current is null)
        {
            <div style="display:grid;place-items:center;height:100%"><Empty Title="Select a conversation" Text="Your messages are private between you and the people you talk to." /></div>
        }
        else
        {
            <div class="chat-head">
                <a href="/messages" class="icon-btn" title="Back">←</a>
                @if (current.Participants.FirstOrDefault() is { } o) { <Avatar User="o" Size="40" /> }
                <button class="icon-btn" title="Voice call" @onclick="() => StartCall(false)">📞</button>
                <button class="icon-btn" title="Video call" @onclick="() => StartCall(true)">🎥</button>
                <div class="grow" style="order:-1"><b>@current.Title</b>@if (typing) { <div class="subtle">typing…</div> } else if (!current.IsGroup && current.Participants.FirstOrDefault() is { } other2 && Realtime.IsOnline(other2.Id)) { <div class="active-text">Active now</div> }</div>
            </div>
            <div class="chat-body" @ref="body">
                @foreach (var m in messages)
                {
                    var mine = m.Sender.Id == Session.User?.Id;
                    <div class="bubble @(mine ? "mine" : "")">@if (current.IsGroup && !mine) {<b style="font-size:.78rem;display:block">@m.Sender.DisplayName</b>}@if (m.MediaUrl is { } url) {<img src="@url" alt="" style="border-radius:12px;max-height:260px" />}@if (m.SharedPost is { } sp) {<a class="chat-post" href="/post/@sp.PostId">@if (sp.ImageUrl is { } im) {<img src="@im" alt="" />}<b>@sp.AuthorName</b><span>@sp.Text</span></a>}<span>@m.Content</span><time>@Clock.Local(m.SentAt).ToString("h:mm tt")</time></div>
                }
            </div>
            @if (smart.Count > 0 && string.IsNullOrEmpty(text))
            {
                <div class="smart-replies" style="padding:.4rem .75rem 0">
                    <span class="ai-tag">✨</span>
                    @foreach (var r in smart) { <button class="chip" @onclick="() => text = r">@r</button> }
                </div>
            }
            <div class="chat-input">
                <label class="icon-btn" title="Send a photo">🖼️<InputFile OnChange="SendPhoto" accept="image/*" style="display:none" /></label>
                <input class="input" placeholder="Write a message…" @bind="text" @bind:event="oninput" @onkeydown="OnKey" style="border-radius:999px" />
                <button class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(text)" @onclick="Send">Send</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }
    private List<ConversationDto> conversations = [];
    private List<MessageDto> messages = [];
    private ConversationDto? current;
    private string? text;
    private List<string> smart = [];
    private Guid? smartFor;

    private async Task RefreshSmartRepliesAsync()
    {
        var last = messages.LastOrDefault();
        if (last is null || last.Sender.Id == Session.User?.Id || string.IsNullOrWhiteSpace(last.Content)) { smart = []; return; }
        if (smartFor == last.Id) return;
        smartFor = last.Id;
        try { smart = (await Api.PostAsync<SmartRepliesResponse>("api/ai/replies", new SmartRepliesRequest(last.Content, "message"))).Replies; }
        catch (Exception) { smart = []; }
    }
    private bool typing, scroll;
    private ElementReference body;
    private DateTime lastTypingSent;
    private System.Threading.Timer? typingTimer;

    protected override void OnInitialized()
    {
        Realtime.MessageReceived += OnMessage;
        Realtime.Typing += OnTyping;
        Realtime.PresenceChanged += OnPresence;
    }

    private void OnPresence() => InvokeAsync(StateHasChanged);

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            conversations = await Api.GetAsync<List<ConversationDto>>("api/conversations");
            current = conversations.FirstOrDefault(c => c.Id == Id);
            if (current is not null)
            {
                messages = await Api.GetAsync<List<MessageDto>>($"api/conversations/{current.Id}/messages");
                scroll = true;
                await RefreshSmartRepliesAsync();
                await Realtime.RefreshCountsAsync();
            }
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scroll) { scroll = false; await JS.InvokeVoidAsync("halalbook.scrollToBottom", body); }
    }

    private void OnMessage(MessageDto m) => InvokeAsync(async () =>
    {
        if (m.ConversationId == current?.Id)
        {
            if (messages.All(x => x.Id != m.Id)) messages.Add(m);
            typing = false; scroll = true;
            await RefreshSmartRepliesAsync();
            if (m.Sender.Id != Session.User?.Id) { await Api.PostAsync($"api/conversations/{m.ConversationId}/read"); await Realtime.RefreshCountsAsync(); }
        }
        conversations = await Api.GetAsync<List<ConversationDto>>("api/conversations");
        StateHasChanged();
    });

    private void OnTyping(Guid conversationId, Guid userId) => InvokeAsync(() =>
    {
        if (conversationId != current?.Id) return;
        typing = true;
        typingTimer?.Dispose();
        typingTimer = new System.Threading.Timer(_ => InvokeAsync(() => { typing = false; StateHasChanged(); }), null, 3000, Timeout.Infinite);
        StateHasChanged();
    });

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) { await Send(); return; }
        if (current is not null && DateTime.UtcNow - lastTypingSent > TimeSpan.FromSeconds(2))
        {
            lastTypingSent = DateTime.UtcNow;
            await Realtime.SendTypingAsync(current.Id);
        }
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(text) || current is null) return;
        var content = text; text = null;
        try
        {
            var m = await Api.PostAsync<MessageDto>($"api/conversations/{current.Id}/messages", new SendMessageRequest(content, null));
            if (messages.All(x => x.Id != m.Id)) messages.Add(m);
            scroll = true;
        }
        catch (Exception ex) { text = content; Toasts.Error(ex); }
    }

    [Inject] private NavigationManager Nav { get; set; } = default!;

    private async Task StartCall(bool video)
    {
        try
        {
            var call = await Api.PostAsync<CallDto>("api/calls", new StartCallRequest(current!.Id, video));
            Nav.NavigateTo($"/call/{call.Id}");
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task SendPhoto(InputFileChangeEventArgs e)
    {
        try
        {
            var up = await Api.UploadAsync(e.File, 8_000_001, "message");
            var m = await Api.PostAsync<MessageDto>($"api/conversations/{current!.Id}/messages", new SendMessageRequest("", up.Url));
            if (messages.All(x => x.Id != m.Id)) messages.Add(m);
            scroll = true;
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    public void Dispose()
    {
        Realtime.MessageReceived -= OnMessage;
        Realtime.Typing -= OnTyping;
        Realtime.PresenceChanged -= OnPresence;
        typingTimer?.Dispose();
    }
}
