@page "/forgot-password"
@layout AuthLayout
@inject ApiClient Api
@inject NavigationManager Nav
@inject Toasts Toasts

<PageTitle>Reset password · HalalBook</PageTitle>

<div class="card">
    <div class="center" style="margin-bottom:1.25rem">
        <div style="font-size:2.4rem">🗝️</div>
        <h1 style="font-family:var(--font-display);font-weight:700">Reset your password</h1>
        <p class="muted">@(sent ? info : "Enter the email for your account and we'll send you a reset code.")</p>
    </div>

    @if (!sent)
    {
        <form class="stack" @onsubmit="Send">
            <label class="field">Email<input class="input" type="email" @bind="email" autocomplete="email" required /></label>
            @if (error is not null) { <div class="error">@error</div> }
            <button class="btn btn-primary btn-block" type="submit" disabled="@busy">@(busy ? "Sending…" : "Send reset code")</button>
        </form>
    }
    else
    {
        <form class="stack" @onsubmit="Reset">
            <label class="field">6-digit code
                <input class="input" style="font-size:1.4rem;letter-spacing:.45rem;text-align:center" inputmode="numeric" autocomplete="one-time-code" maxlength="6" @bind="code" required />
            </label>
            <label class="field">New password<input class="input" type="password" @bind="password" autocomplete="new-password" minlength="8" required /></label>
            <label class="field">Confirm new password<input class="input" type="password" @bind="confirm" autocomplete="new-password" required /></label>
            @if (error is not null) { <div class="error">@error</div> }
            <button class="btn btn-gold btn-block" type="submit" disabled="@busy">@(busy ? "Saving…" : "Set new password")</button>
            <a href="javascript:void(0)" class="center" style="font-size:.88rem" @onclick="Send">Send a new code</a>
        </form>
    }
    <hr class="ornament" style="margin:1.25rem 0" />
    <p class="center muted"><a href="/login">Back to sign in</a></p>
</div>

@code {
    private string? email, code, password, confirm, error, info;
    private bool busy, sent;

    private async Task Send()
    {
        busy = true; error = null;
        try
        {
            info = (await Api.PostAsync<AuthResult>("api/auth/forgot-password", new EmailRequest(email ?? ""))).Message;
            sent = true;
        }
        catch (ApiException ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task Reset()
    {
        if (password != confirm) { error = "The passwords don't match."; return; }
        busy = true; error = null;
        try
        {
            var r = await Api.PostAsync<AuthResult>("api/auth/reset-password", new ResetPasswordRequest(email ?? "", code ?? "", password ?? ""));
            Toasts.Show(r.Message ?? "Password reset");
            Nav.NavigateTo("/login");
        }
        catch (ApiException ex) { error = ex.Message; }
        finally { busy = false; }
    }
}
