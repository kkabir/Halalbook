@page "/reels"
@inject ApiClient Api
@inject Toasts Toasts
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Reels · HalalBook</PageTitle>

<div class="feed-column reels-page">
    <div class="reel-tabs">
        @if (Tag is not null)
        {
            <a class="on" href="/reels">#@Tag.TrimStart('#') ✕</a>
        }
        else
        {
            <button class="@(!following ? "on" : "")" @onclick="() => SwitchTab(false)">@T("For you")</button>
            <button class="@(following ? "on" : "")" @onclick="() => SwitchTab(true)">@T("Following")</button>
        }
    </div>
    <div class="reel-create row">
        <button class="btn btn-ghost btn-sm" @onclick="ToggleMute">@(muted ? "🔇" : "🔊")</button>
        <button class="btn btn-ghost btn-sm" @onclick="ToggleLoop" title="@(loop ? T("Repeat each video") : T("Play the next video automatically"))">@(loop ? "🔁" : "⏭️")</button>
        <button class="btn btn-gold btn-sm" @onclick="() => creating = true">🎬 @T("Create")</button>
    </div>

    @if (loading) { <div class="spinner"></div> }
    else if (reels.Count == 0)
    {
        <div class="card mt"><Empty Title="@(following ? "No reels from people you follow yet" : "No reels yet")" Text="Short, beneficial vertical videos live here. Be the first to share one!"><button class="btn btn-primary" @onclick="() => creating = true">🎬 Create a reel</button></Empty></div>
    }
    else
    {
        <div class="reels" @ref="container">
            @foreach (var r in reels)
            {
                <div class="reel" @key="r.Id" data-id="@r.Id">
                    <video src="@r.Media.First(m => m.Type == MediaType.Video).Url" playsinline muted preload="metadata" @ref="videoRefs[r.Id]"></video>
                    <div class="reel-tap" @ondblclick="() => DoubleTapLike(r)" @onclick="() => TogglePlay(r.Id)"></div>
                    @if (heartFor == r.Id) { <div class="reel-heart">❤️</div> }
                    <div class="reel-progress"><i></i></div>
                    <div class="reel-side">
                        <div><button class="@(r.MyReaction is not null ? "on" : "")" @onclick="() => React(r)" title="MashaAllah">✨</button><small>@Ui.Compact(r.TotalReactions)</small></div>
                        <div><a href="/post/@r.Id" title="Comments">💬</a><small>@r.CommentCount</small></div>
                        <div><button class="@(r.IsBookmarked ? "on" : "")" @onclick="() => Save(r)" title="Save">🔖</button></div>
                        <div><button @onclick="() => Copy(r)" title="Share">↗</button><small>@r.ShareCount</small></div>
                    </div>
                    <div class="info">
                        <div class="row"><Avatar User="r.Author" Size="38" Ring="true" /><a href="/u/@r.Author.UserName" style="color:#fff;font-weight:700">@r.Author.DisplayName</a></div>
                        @if (!string.IsNullOrWhiteSpace(r.Content)) { <p style="margin:.5rem 0 0">@(r.TranslatedContent ?? r.Content)</p> }
                        <small class="reel-views">▶ @Ui.Compact(r.ViewCount) @T("views")</small>
                    </div>
                </div>
            }
            @if (hasMore) { <div class="center" style="padding:1rem"><button class="btn btn-outline" @onclick="More">Load more reels</button></div> }
        </div>
    }
</div>

@if (creating)
{
    <div class="overlay" @onclick="() => creating = false">
        <div class="modal" style="width:min(640px,100%)" @onclick:stopPropagation>
            <h2>Create a reel</h2>
            <p class="subtle">Upload a vertical video (up to 100 MB). Keep it halal, short and beneficial.</p>
            <Composer ReelMode="true" Placeholder="Write a caption… #reminder" OnPosted="Posted" />
        </div>
    </div>
}

@code {
    private readonly List<PostDto> reels = [];
    private readonly Dictionary<Guid, ElementReference> videoRefs = [];
    private ElementReference container;
    private int page = 1;
    private bool loading = true, hasMore, creating, muted = true, observe, following;
    private Guid? heartFor;
    private DotNetObjectReference<Reels>? self;

    [SupplyParameterFromQuery] public Guid? Start { get; set; }
    [SupplyParameterFromQuery] public string? Tag { get; set; }
    private bool loop;
    [SupplyParameterFromQuery(Name = "create")] public int? Create { get; set; }

    protected override async Task OnInitializedAsync()
    {
        creating = Create == 1;
        try { loop = await JS.InvokeAsync<bool>("halalbook.reelLoop", (bool?)null); } catch (JSException) { }
        await Load();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (observe && reels.Count > 0)
        {
            observe = false;
            self ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("halalbook.observeReels", container, self);
        }
    }

    /// <summary>Called from the browser once a reel has played for a couple of seconds.</summary>
    [JSInvokable]
    public async Task Watched(string id)
    {
        if (Guid.TryParse(id, out var g)) { try { await Api.PostAsync($"api/posts/{g}/view"); } catch (Exception) { } }
    }

    private async Task ToggleLoop()
    {
        loop = await JS.InvokeAsync<bool>("halalbook.reelLoop", !loop);
        Toasts.Show(loop ? T("Each video repeats") : T("Videos play one after another"));
    }

    /// <summary>The last video ended in auto-next mode: fetch more so the row keeps going.</summary>
    [JSInvokable]
    public async Task NearEnd() { if (hasMore) { await More(); StateHasChanged(); } }

    private async Task SwitchTab(bool f)
    {
        if (following == f) return;
        following = f; page = 1; reels.Clear(); loading = true;
        await Load();
    }

    private async Task DoubleTapLike(PostDto r)
    {
        heartFor = r.Id;
        if (r.MyReaction is null) await React(r);
        StateHasChanged();
        await Task.Delay(800);
        heartFor = null;
    }

    private async Task Load()
    {
        try
        {
            var res = await Api.GetAsync<PagedResult<PostDto>>($"api/reels?page={page}&following={following.ToString().ToLowerInvariant()}{(Start is Guid s && page == 1 ? $"&start={s}" : "")}{(Tag is null ? "" : $"&tag={Uri.EscapeDataString(Tag)}")}");
            reels.AddRange(res.Items.Where(r => r.Media.Any(m => m.Type == MediaType.Video) && reels.All(x => x.Id != r.Id)));
            hasMore = res.HasMore;
            observe = true;
        }
        catch (Exception ex) { Toasts.Error(ex); }
        finally { loading = false; }
    }

    private async Task More() { page++; await Load(); }

    private async Task ToggleMute() => muted = await JS.InvokeAsync<bool>("halalbook.toggleMute", container);

    private async Task TogglePlay(Guid id)
    {
        if (videoRefs.TryGetValue(id, out var v)) await JS.InvokeVoidAsync("halalbook.togglePlay", v);
    }

    private void Replace(PostDto old, PostDto updated) => reels[reels.IndexOf(old)] = updated;

    private async Task React(PostDto r)
    {
        try
        {
            var counts = new Dictionary<ReactionType, int>(r.Reactions);
            if (r.MyReaction is { } mine)
            {
                await Api.DeleteAsync($"api/posts/{r.Id}/reaction");
                counts[mine] = Math.Max(0, counts.GetValueOrDefault(mine) - 1);
                Replace(r, r with { MyReaction = null, Reactions = counts });
            }
            else
            {
                await Api.PutAsync($"api/posts/{r.Id}/reaction", new ReactRequest(ReactionType.MashaAllah));
                counts[ReactionType.MashaAllah] = counts.GetValueOrDefault(ReactionType.MashaAllah) + 1;
                Replace(r, r with { MyReaction = ReactionType.MashaAllah, Reactions = counts });
            }
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task Save(PostDto r)
    {
        try
        {
            if (r.IsBookmarked) await Api.DeleteAsync($"api/posts/{r.Id}/bookmark");
            else await Api.PostAsync($"api/posts/{r.Id}/bookmark");
            Replace(r, r with { IsBookmarked = !r.IsBookmarked });
        }
        catch (Exception ex) { Toasts.Error(ex); }
    }

    private async Task Copy(PostDto r)
    {
        await JS.InvokeVoidAsync("halalbook.copy", Nav.ToAbsoluteUri($"/post/{r.Id}").ToString());
        Toasts.Show("Link copied");
    }

    private void Posted(PostDto p)
    {
        creating = false;
        if (p.Kind == PostKind.Reel) { reels.Insert(0, p); observe = true; }
    }

    public void Dispose() => self?.Dispose();
}
