@* Facebook-style photo/video grid: up to 4 tiles with a "+N" overlay, opening a full-screen lightbox. *@
@if (Media.Count > 0)
{
    <div class="media-grid n@(Math.Min(Media.Count, 4))">
        @for (int i = 0; i < Math.Min(Media.Count, 4); i++)
        {
            var index = i;
            var m = Media[i];
            <div class="media-tile" @onclick="() => Open(index)">
                @if (m.Type == MediaType.Video)
                {
                    @if (Media.Count == 1)
                    {
                        <video src="@m.Url" controls preload="metadata" playsinline @onclick:stopPropagation></video>
                    }
                    else
                    {
                        <video src="@m.Url#t=0.1" preload="metadata" muted playsinline></video>
                        <span class="play-badge">▶</span>
                    }
                }
                else
                {
                    <img src="@m.Url" alt="" loading="lazy" />
                }
                @if (i == 3 && Media.Count > 4)
                {
                    <span class="more">+@(Media.Count - 4)</span>
                }
            </div>
        }
    </div>
}

@if (open is int current)
{
    var m = Media[current];
    <div class="overlay lightbox" @onclick="Close" @onkeydown="OnKey" tabindex="0" @ref="box">
        <button class="icon-btn lb-close" @onclick="Close" aria-label="Close">✕</button>
        @if (Media.Count > 1)
        {
            <button class="icon-btn lb-prev" @onclick:stopPropagation @onclick="() => Step(-1)" aria-label="Previous">‹</button>
            <button class="icon-btn lb-next" @onclick:stopPropagation @onclick="() => Step(1)" aria-label="Next">›</button>
            <div class="lb-count">@(current + 1) / @Media.Count</div>
        }
        <div class="lb-stage" @onclick:stopPropagation>
            @if (m.Type == MediaType.Video)
            {
                <video @key="m.Url" src="@m.Url" controls autoplay playsinline></video>
            }
            else
            {
                <img @key="m.Url" src="@m.Url" alt="" />
            }
        </div>
    </div>
}

@code {
    [Parameter] public List<MediaDto> Media { get; set; } = [];
    private int? open;
    private ElementReference box;

    private void Open(int i) => open = i;
    private void Close() => open = null;
    private void Step(int d) => open = (open!.Value + d + Media.Count) % Media.Count;

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowRight") Step(1);
        else if (e.Key == "ArrowLeft") Step(-1);
        else if (e.Key == "Escape") Close();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (open is not null) { try { await box.FocusAsync(); } catch (Exception) { } }
    }
}
