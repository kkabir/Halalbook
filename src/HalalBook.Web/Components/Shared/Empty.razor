<div class="empty">
    <svg viewBox="0 0 64 64" aria-hidden="true">
        <path d="M10 61V31C10 18.5 20 9 32 3c12 6 22 15.5 22 28v30z" fill="none" stroke="#c9a227" stroke-width="2" />
        <g transform="translate(32 30)" fill="#13866a" opacity=".7">
            <rect x="-6" y="-6" width="12" height="12" /><rect x="-6" y="-6" width="12" height="12" transform="rotate(45)" />
        </g>
    </svg>
    <h3>@Title</h3>
    <p class="muted">@Text</p>
    @ChildContent
</div>

@code {
    [Parameter] public string Title { get; set; } = "Nothing here yet";
    [Parameter] public string? Text { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
