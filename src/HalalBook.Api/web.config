<?xml version="1.0" encoding="utf-8"?>
<!-- IIS settings merged into the published web.config (SmarterASP.net). Caps uploads just above the 60 MB video limit (Media:MaxVideoMB). -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="62000000" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
