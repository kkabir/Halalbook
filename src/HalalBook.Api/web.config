<?xml version="1.0" encoding="utf-8"?>
<!-- IIS settings merged into the published web.config (SmarterASP.net). Allows ~100 MB video uploads. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="110000000" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
